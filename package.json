  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "@google/genai": "^2.27.0"
  }
