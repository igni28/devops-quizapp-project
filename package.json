{
  "name": "quizapp",
  "version": "1.0.0",
  "private": true,
  "description": "This is a beautiful, functional and responsive, web-based trivia quiz application that allows users to test their knowledge on select categories of questions. The app is built using HTML, CSS, and JavaScript, and utilizes The Trivia API to generate random questions.",
  "main": "script.js",
  "scripts": {
    "test": "node --test",
    "check": "node --check script.js && node --check quizLogic.js",
    "lint": "eslint script.js quizLogic.js tests",
    "test:e2e": "playwright test",
    "generate:ai": "node llm/generate.mjs",
    "evaluate:ai": "node llm/evaluate.mjs",
    "judge:ai": "node llm/judge.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igni28/devops-quizapp-project.git"
  },
